# Server-only DeepSeek configuration. Never prefix the key with NEXT_PUBLIC_.
# The placeholder is detected and treated as "no key configured".
DEEPSEEK_API_KEY=sk-placeholder-replace-me
DEEPSEEK_MODEL=deepseek-flash

# Optional: AI city line art generation via Alibaba Cloud DashScope (Qwen-Image).
# Get key from https://bailian.console.aliyun.com/ (Model Studio control panel).
# Omit to disable text-entry generation (returns a clear error instead of a fallback image).
# DASHSCOPE_API_KEY=sk-your-dashscope-key
# DASHSCOPE_WORKSPACE_ID=your-workspace-id  # optional, for dedicated endpoint
# QWEN_IMAGE_MODEL=qwen-image-3.0           # optional, supports generation + photo line-art conversion
